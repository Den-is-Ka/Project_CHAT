# Создайте файл .env из копии этого файла и замените значения переменных реальными данными

# Обязательно задайте надёжный SECRET_KEY (django.core.management.utils.get_random_secret_key())
SECRET_KEY=замените_на_реальный_secret_key

# False для разработки, True — для продакшена
DEBUG=False

# Через запятую: хосты, с которых разрешено обращаться к сайту
# ALLOWED_HOSTS=127.0.0.1,localhost,example.com
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Origin-ы, которым доверяет CSRF (для форм логина/регистрации)
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,https://example.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# PostgreSQL
DB_NAME=project_chat
DB_USER=project_chat
DB_PASSWORD=замените_на_надёжный_пароль
DB_HOST=localhost
DB_PORT=5432

# Хранилище для состояния WebSocket и кэша
REDIS_HOST=localhost
REDIS_PORT=6379

# True, если сайт работает за HTTPS (nginx): включает HSTS, secure-cookies,
# редирект на HTTPS
USE_HTTPS=False

# SMTP-бэкенд для писем (по умолчанию письма выводятся в консоль)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=password
# EMAIL_USE_TLS=True

# Начальные данные (seed_initial запускается при старте web).
# На пустой базе обе переменные обязательны: значения по умолчанию отключены.
# Пароль должен проходить стандартные валидаторы паролей Django.
# SEED_ADMIN_USERNAME=demo_admin
# SEED_ADMIN_PASSWORD=замените_на_надёжный_уникальный_пароль
